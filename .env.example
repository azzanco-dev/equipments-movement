NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# UltraMsg WhatsApp gateway for movement notices. Server only: never prefix with NEXT_PUBLIC_.
ULTRAMSG_INSTANCE_ID=instance00000
ULTRAMSG_TOKEN=your-ultramsg-token
# Afaqy AVL tracking (wave 17): equipment positions for the admin. Server only:
# never prefix with NEXT_PUBLIC_. AFAQY_API_URL is optional (default https://api.afaqy.pro).
AFAQY_USERNAME=your-afaqy-username
AFAQY_PASSWORD=your-afaqy-password
AFAQY_API_URL=https://api.afaqy.pro
# Server only: the site origin the WhatsApp notice links point to. REQUIRED for
# the exit link in workshop-arrival notices: without it (or with a value that is
# not a plain https origin) notices go out without the link; the request origin
# is never used. Set it in Vercel for Production and Preview. Never prefix with
# NEXT_PUBLIC_.
# APP_BASE_URL=https://your-domain.example
